{
  "manifest_version": 3,
  "name": "Google Voice Enterprise Auto Dialer",
  "version": "0.1.0",
  "description": "Queue-based outbound dialer for Google Voice. Import leads, auto-dial with a delay, tag outcomes, export an XLSX call report.",

  "permissions": ["sidePanel", "storage", "alarms"],
  "host_permissions": ["https://voice.google.com/*", "https://gv-auto-dialer-chrome-extension.onrender.com/*"],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "side_panel": {
    "default_path": "sidepanel/index.html"
  },

  "action": {
    "default_title": "Open Auto Dialer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["https://voice.google.com/*"],
      "js": ["content/selectors.js", "content/inject.js"],
      "css": ["content/hud.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
