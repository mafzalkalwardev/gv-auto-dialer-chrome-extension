{
  "manifest_version": 3,
  "name": "GV Auto Dialer by Indus Web Agency",
  "version": "0.2.1",
  "description": "Google Voice auto dialer by Indus Web Agency — import leads, auto-dial, tag outcomes, export XLSX. WhatsApp +92 307 9670503.",

  "permissions": ["sidePanel", "storage", "alarms"],
  "host_permissions": ["https://voice.google.com/*", "https://gv-auto-dialer-accounts.vercel.app/*"],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "side_panel": {
    "default_path": "sidepanel/index.html"
  },

  "action": {
    "default_title": "GV Auto Dialer — Indus Web Agency",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["https://voice.google.com/*"],
      "js": ["content/selectors.js", "content/inject.js"],
      "css": ["content/hud.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
