# Copy to .env for local testing. On Render, set these in the
# service's Environment tab instead of committing a real .env file.

# Provided automatically if you create the Postgres database on Render
# and link it to this service. Otherwise paste your database's
# connection string here.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Login for https://YOUR-BACKEND-DOMAIN/admin — pick your own values.
# Use a long random password; this page controls every client's access.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long-and-random

PORT=3000
